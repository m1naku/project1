<Window x:Class="LibraryApp.Views.BookEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="460" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Название" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

            <TextBlock Text="Автор" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="Жанр" Style="{StaticResource Caption}"/>
                    <ComboBox ItemsSource="{Binding AvailableGenres}" SelectedItem="{Binding Genre}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Оценка (0–5)" Style="{StaticResource Caption}"/>
                    <ComboBox ItemsSource="{Binding AvailableRatings}" SelectedItem="{Binding Rating}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="Год" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Страниц" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <CheckBox Content="Прочитана" IsChecked="{Binding IsRead}" Margin="0,8,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="#C0392B"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
